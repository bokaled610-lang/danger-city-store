# انسخ هالملف باسم .env محلياً، أو حط نفس المتغيرات في Railway → Variables

# رابط موقعك (من Railway بعد النشر)
BASE_URL=https://your-app.up.railway.app

# رابط قاعدة البيانات (Railway يعطيك إياه من خدمة PostgreSQL)
DATABASE_URL=postgresql://user:pass@host:5432/railway

# أي نص عشوائي طويل وسري
SESSION_SECRET=change-this-to-a-long-random-string

# من Discord Developer Portal → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-app.up.railway.app/auth/discord/callback

# Discord IDs حقت الأدمنية، مفصولة بفاصلة (حط الـ ID حقك هنا عشان تفتح لك لوحة الإدارة)
DISCORD_ADMIN_IDS=123456789012345678
